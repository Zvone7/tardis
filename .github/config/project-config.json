{
    "projects": [
        {
            "name": "TripPlanner",
            "tag": "[TP]",
            "paths": [
                "^projects/tripplanner/.*",
                "^\\.github/workflows/tripplanner.*\\.yml$"
            ],
            "autoPrToDev": true,
            "autoPrToProduction": false,
            "devTargets": [
                "dev/tripplanner/fe",
                "dev/tripplanner/be"
            ],
            "productionTargets": []
        },
        {
            "name": "ApartmentPicker",
            "tag": "[AP]",
            "paths": [
                "^projects/apartmentpicker/.*",
                "^\\.github/workflows/apartmentpicker.*\\.yml$"
            ],
            "autoPrToDev": true,
            "autoPrToProduction": false,
            "devTargets": [
                "dev/apartmentpicker/fe",
                "dev/apartmentpicker/be"
            ],
            "productionTargets": []
        },
        {
            "name": "Infrastructure",
            "tag": "[INFRA]",
            "paths": [
                "^\\.github/.*",
                "^iac/.*"
            ],
            "autoPrToDev": false,
            "autoPrToProduction": false,
            "devTargets": [],
            "productionTargets": []
        }
    ],
    "services": [
        {
            "name": "tripplanner/be",
            "paths": [
                "^projects/tripplanner/backend/.*",
                "^projects/tripplanner/Dockerfile\\.be$"
            ]
        },
        {
            "name": "tripplanner/fe",
            "paths": [
                "^projects/tripplanner/frontend/.*",
                "^projects/tripplanner/Dockerfile\\.fe$"
            ]
        },
        {
            "name": "apartmentpicker/be",
            "paths": [
                "^projects/apartmentpicker/backend/.*",
                "^projects/apartmentpicker/Dockerfile\\.be$"
            ]
        },
        {
            "name": "apartmentpicker/fe",
            "paths": [
                "^projects/apartmentpicker/frontend/.*",
                "^projects/apartmentpicker/Dockerfile\\.fe$"
            ]
        }
    ]
}
